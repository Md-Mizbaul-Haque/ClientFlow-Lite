PORT=5000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/clientflow?schema=public
# Min 32 characters. Generate one with: openssl rand -base64 32
# Production refuses to boot on a short, placeholder, or shared dev secret.
JWT_SECRET=dev-only-9f2c7a41b8e54d0fa3c6b1e7082d4a55
# Separate secret for refresh tokens — compromising access token secret
# does not compromise refresh tokens.
REFRESH_TOKEN_SECRET=dev-only-rT9kLm2xPq4vNw7bYj5hFg3sDc8eUi1o
# S3-compatible logo storage (R2, MinIO, or AWS). Uploads go straight from
# the browser via presigned PUTs issued by POST /api/uploads/logo.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=clientflow-lite
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.example.com
