{
  "extends": "@repo/config-typescript/next.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@repo/types": [
        "../../packages/types/src"
      ],
      "@repo/ui/*": [
        "../../packages/ui/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-dev/types/**/*.ts"
  ],
  // `.next/types` stays included (that is where `next build` writes the
  // generated route types). `.next-dev` stays out: the dev server rewrites it
  // continuously, so type-checking it would race a live process.
  "exclude": [
    "node_modules",
    ".next-dev"
  ]
}
